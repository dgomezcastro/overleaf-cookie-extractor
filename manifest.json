{
  "manifest_version": 3,
  "name": "Overleaf Cookie for VS Code",
  "version": "1.0.0",
  "description": "Copy your Overleaf session cookie to the clipboard for the Overleaf Workshop VS Code extension (Login with Cookies).",
  "browser_specific_settings": {
    "gecko": {
      "id": "overleaf-cookie-extractor@dgomezcastro.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "cookies",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.overleaf.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Copy Overleaf cookie",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
